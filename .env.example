PORT=3002

# --- Base de datos (Supabase) ---
# Supabase → Project Settings → Database → Connection string → ORMs/Prisma.
# App (Transaction pooler, puerto 6543). pgbouncer=true es obligatorio con Prisma.
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Migraciones (Session pooler, puerto 5432).
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres"
# Postgres local: usa la misma URL en las dos variables, p. ej.
# DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"
# DIRECT_URL="postgresql://user:password@localhost:5432/dbname?schema=public"

JWT_SECRET="your-secret-key"
JWT_EXPIRES_IN=86400
# Orígenes permitidos por CORS separados por comas (por defecto '*')
CORS_ORIGIN="https://tu-frontend.vercel.app"

# --- Asesor IA (Groq) ---
# Clave de https://console.groq.com/keys. Nunca la subas al repositorio.
GROQ_API_KEY=""
# Modelo de Groq (opcional). Por defecto: openai/gpt-oss-120b
GROQ_MODEL="openai/gpt-oss-120b"
# Consultas por usuario cada 10 minutos (opcional, 20 por defecto)
ADVISOR_MAX_REQUESTS_PER_10_MIN=20
